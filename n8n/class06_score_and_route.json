{
  "name": "Class 6 - Score and Route",
  "nodes": [
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:8000/score",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ $json }}",
        "options": {}
      },
      "name": "Score Transaction",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.severity }}",
                    "rightValue": "high",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "High"
            },
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.severity }}",
                    "rightValue": "medium",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ]
              },
              "renameOutput": true,
              "outputKey": "Medium"
            }
          ]
        },
        "fallbackOutput": "extra",
        "options": {}
      },
      "name": "Route by Severity",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [920, 300]
    }
  ],
  "notes": "Wire your existing Class 5 Webhook node's output into 'Score Transaction'. Its three outputs (High / Medium / fallback=Normal) then go to: High -> Slack/Email alert node (class 7); Medium & Normal -> a Google Sheets/dashboard-logging node (class 8)."
}
